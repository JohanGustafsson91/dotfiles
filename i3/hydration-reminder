#!/bin/sh

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/i3blocks"
state_file="$cache_dir/hydration-reminder"
notified_file="$cache_dir/hydration-reminder-notified"
snooze_file="$cache_dir/hydration-reminder-snooze"
interval=3600
now=$(date +%s)

mkdir -p "$cache_dir"
next=$(sed -n '1p' "$state_file" 2>/dev/null)
case "$next" in
    ''|*[!0-9]*)
        next=$((now + interval))
        printf '%s\n' "$next" > "$state_file"
        ;;
esac

snooze_minutes=$(sed -n '1p' "$snooze_file" 2>/dev/null)
case "$snooze_minutes" in
    5|10|15|20|25|30|35|40|45|50|55|60) ;;
    *) snooze_minutes=5 ;;
esac

case "${BLOCK_BUTTON:-}" in
    1)
        next=$((now + interval))
        printf '%s\n' "$next" > "$state_file"
        printf '5\n' > "$snooze_file"
        rm -f "$notified_file"
        notify-send -u low -t 2500 'Hydration reminder' 'Good job — next reminder in one hour.' >/dev/null 2>&1 &
        ;;
    2)
        next=$((now + snooze_minutes * 60))
        printf '%s\n' "$next" > "$state_file"
        if [ "$snooze_minutes" -ge 60 ]; then
            next_snooze=5
        else
            next_snooze=$((snooze_minutes + 5))
        fi
        printf '%s\n' "$next_snooze" > "$snooze_file"
        rm -f "$notified_file"
        notify-send -u low -t 2500 'Hydration reminder' "Snoozed for ${snooze_minutes} minutes." >/dev/null 2>&1 &
        ;;
    3)
        next=$((now + 300))
        printf '%s\n' "$next" > "$state_file"
        printf '5\n' > "$snooze_file"
        rm -f "$notified_file"
        notify-send -u low -t 2500 'Hydration reminder' 'Snoozed for 5 minutes.' >/dev/null 2>&1 &
        ;;
esac

if [ "$now" -ge "$next" ]; then
    if [ "$(sed -n '1p' "$notified_file" 2>/dev/null)" != "$next" ]; then
        notify-send -u normal -t 8000 'Stand and hydrate' 'Take a short standing break and drink some water.' >/dev/null 2>&1 &
        printf '%s\n' "$next" > "$notified_file"
    fi

    overdue=$((now - next))
    if [ "$overdue" -ge 600 ]; then
        color='#E52E2E'
    else
        color='#FFCC66'
    fi

    case $(((now / 2) % 3)) in
        0) text='🧍  STAND UP' ;;
        1) text='󰖙  DRINK WATER' ;;
        *) text='🧍  +  󰖙' ;;
    esac
else
    minutes=$(((next - now + 59) / 60))
    text="󰖙  ${minutes}m"
    color='#5C7A91'
fi

printf '%s\n%s\n%s\n' "$text" "$text" "$color"
