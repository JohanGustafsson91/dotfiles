#!/bin/bash

case "${BLOCK_BUTTON:-}" in
    1) ~/.config/scripts/music.sh menu >/dev/null 2>&1 & ;;
    2) ~/.config/scripts/music.sh next >/dev/null 2>&1 & ;;
    3) ~/.config/scripts/music.sh play-pause >/dev/null 2>&1 & ;;
esac

if ! command -v playerctl >/dev/null 2>&1; then
    printf '♪ Install playerctl\n♪ Music\n#5C7A91\n'
    exit
fi

player=(playerctl --player=spotify,%any)
status=$("${player[@]}" status 2>/dev/null)
if [ -z "$status" ]; then
    printf '♪ Music\n♪ Music\n#5C7A91\n'
    exit
fi

title=$("${player[@]}" metadata --format '{{artist}} — {{title}}' 2>/dev/null)
title=${title//$'\n'/ }
title=${title//$'\r'/ }
[ -n "$title" ] || title=Music
if [ "${#title}" -gt 40 ]; then
    title="${title:0:39}…"
fi
if [ "$status" = Playing ]; then
    icon='▶'
    color='#47FF9C'
else
    icon='Ⅱ'
    color='#5C7A91'
fi
printf '%s %s\n%s Music\n%s\n' "$icon" "$title" "$icon" "$color"
