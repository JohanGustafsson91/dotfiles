#!/bin/bash

if [ "${BLOCK_BUTTON:-}" = 1 ]; then
    alacritty --config-file ~/.config/alacritty/nmtui.toml --title 'Network' -e nmtui >/dev/null 2>&1 &
fi

connection=$(nmcli -t -f TYPE,STATE,CONNECTION dev status | \
    awk -F: '$1=="wifi" && $2=="connected" {print $3; exit}')

signal=$(nmcli -t -f IN-USE,SIGNAL dev wifi | \
    awk -F: '$1=="*" {print $2; exit}')

vpn=$(nmcli -t -f TYPE,STATE,NAME connection show --active | \
    awk -F: '$1=="vpn" && $2=="activated" {print "🔒 " $3; exit}')

if [ -z "$connection" ]; then
    printf '󰖪 offline\n󰖪 offline\n#5C7A91\n'
    exit
fi

if [ -z "$signal" ]; then
    icon="󰤯"
    color='#E52E2E'
elif [ "$signal" -ge 80 ]; then
    icon="󰤨"
    color='#47FF9C'
elif [ "$signal" -ge 60 ]; then
    icon="󰤥"
    color='#9CDCFE'
elif [ "$signal" -ge 40 ]; then
    icon="󰤢"
    color='#FFCC66'
elif [ "$signal" -ge 20 ]; then
    icon="󰤟"
    color='#FFCC66'
else
    icon="󰤯"
    color='#E52E2E'
fi

text="$icon  $connection${vpn:+  $vpn}"
printf '%s\n%s\n%s\n' "$text" "$text" "$color"
